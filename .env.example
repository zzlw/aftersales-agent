# ===== LLM（OpenAI 兼容，多 Provider 可切换）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat            # 生成主模型
LLM_MODEL_FAST=deepseek-chat       # 路由/评估用小快模型（DeepSeek 同名即可）

# ===== Embedding（硅基流动 bge-m3，OpenAI 兼容）=====
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ===== 其他 =====
# 本机直连开发库时用 5433 端口；容器内由 compose 覆盖为 db:5432
DATABASE_URL=postgresql://agent:agent@localhost:5433/aftersales
